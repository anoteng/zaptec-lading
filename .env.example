# Eksempel på .env for lading-tjenesten.
#
#   cp .env.example .env && chmod 600 .env
#
# Fyll inn verdiene etter likhetstegnet, uten mellomrom rundt «=». .env står i .gitignore og skal aldri i git.
# Miljøvariabler med samme navn (f.eks. fra systemd) vinner over .env.
#
# Del 1 er påkrevd. Resten er valgfrie overstyringer av standardverdiene i config.toml: alle linjer som er
# kommentert ut, viser standardverdien. Fjern «#» og endre verdien for å bruke noe annet.
# Navnet er LADING_<SEKSJON>_<NØKKEL>, så LADING_STYRING_MODUS tilsvarer [styring] modus i config.toml.
# Tabeller (tariffperioder og kapasitetstrinn) kan ikke settes her; de endres i config.toml.
# Strømavtale (påslag, fastbeløp) og støtteordning (Norgespris/strømstønad) settes enklest på websiden.


# ─── 1. Påkrevd ──────────────────────────────────────────────────────────────────────────────────────────

# Zaptec: samme konto som i Zaptec-appen / portal.zaptec.com. Kontoen må eie (eller ha brukertilgang til)
# installasjonen, ellers kan ikke tjenesten styre laderen.
ZAPTEC_USER=
ZAPTEC_PASSWORD=

# Tibber: personlig token fra https://developer.tibber.com/settings/access-token
# Krever Tibber Pulse (eller en annen sanntidsmåler Tibber støtter) på HAN-porten. Tibber-strømavtale er ikke nødvendig.
TIBBER_TOKEN=

# ID-er for din installasjon. Fyll inn tokenene over først, og kjør så:  .venv/bin/python -m lading.finn
LADING_TIBBER_HOME_ID=
LADING_ZAPTEC_INSTALLATION_ID=
LADING_ZAPTEC_CHARGER_ID=


# ─── 2. Valgfritt: Elvia ─────────────────────────────────────────────────────────────────────────────────

# Elvia: Min side → Tilganger → «Opprett token for målerverdier i API» (vises bare én gang).
# Gir nettselskapets avregnede timeverdier, som brukes til å kontrollere og fylle hull i Pulse-dataene.
# Uten token går tjenesten fint på Pulse alene. Andre nettselskap er ikke støttet her.
ELVIA_METERVALUES_TOKEN=

# LADING_ELVIA_FRA=2025-08-01            # hent timeverdier fra denne datoen (start på kundeforholdet / historikken)
# LADING_ELVIA_HENT_KL=10                # klokkeslett for daglig henting av gårsdagens timeverdier
# LADING_ELVIA_BACKFILL_PAUSE_MIN=5      # minutter mellom kall når historikken hentes (skåner kvoten)


# ─── 2b. Valgfritt: varsler ──────────────────────────────────────────────────────────────────────────────

# Push-varsler via ntfy (https://ntfy.sh), f.eks. «kutt 1,3 kW de neste 20 min» før kapasitetstrinnet øker.
#   1. Lag et langt, tilfeldig topic-navn. Alle som kjenner navnet, kan lese varslene, så ikke bruk noe gjettbart:
#        python3 -c "import secrets; print('lading-' + secrets.token_hex(12))"
#   2. Installer ntfy-appen på mobilen og abonner på topicen (server ntfy.sh).
#   3. Sett NTFY_URL til https://ntfy.sh/<topic> og test:  .venv/bin/python -m lading.varsel
# Egen ntfy-server: bruk dens adresse, og NTFY_TOKEN hvis topicen krever innlogging (tilgangstoken tk_…).
# Uten NTFY_URL brukes kommandoen /usr/local/bin/varsle hvis den finnes, ellers havner varslene bare i loggen.
NTFY_URL=
NTFY_TOKEN=

# LADING_VARSEL_EFFEKT=true              # varsle når forbruket ligger an til å øke kapasitetstrinnet
# LADING_VARSEL_EFFEKT_FRA_MIN=5         # tidligst så mange minutter ut i timen
# LADING_VARSEL_LENKE=                   # adresse som åpnes når man trykker på varselet


# ─── 2c. Valgfritt: varmepumpe (Mitsubishi, MELCloud Home) ───────────────────────────────────────────────

# Status, styring og strømforbruk per time for luft-luft-varmepumper i MELCloud Home-appen.
# Enklest: logg inn under «Varmepumpe» på websiden. Innloggingen testes og skrives hit av tjenesten.
# Bruker det uoffisielle API-et (biblioteket aiomelcloudhome, som Home Assistant bruker).
MELCLOUD_USER=
MELCLOUD_PASSWORD=


# Værvarsel fra Open-Meteo (gratis, uten nøkkel) for temperaturjustert månedsprognose. «bredde,lengde» i
# desimalgrader, gjerne avrundet til én desimal. Bare posisjonen sendes. Tom = av.
# «.venv/bin/python -m lading.finn» foreslår en verdi ut fra adressen i Tibber.
# LADING_VAER_POSISJON=59.9,10.8


# ─── 3. Styring ──────────────────────────────────────────────────────────────────────────────────────────

# av     = styringen kjører ikke (bare logging og statusside)
# dryrun = regner og logger hva den ville gjort, sender ingen kommandoer til laderen (anbefalt start)
# aktiv  = pauser/gjenopptar ladingen og setter ladestrøm via Zaptec.
#          Slå av Eco-modus og planlagt lading i Zaptec-appen først; Zaptec avviser strømendringer ellers.
# LADING_STYRING_MODUS=dryrun

# LADING_STYRING_TIMER_PER_DOGN=6        # antatt antall ladetimer per natt (til batterinivå fra bilen er på plass)
# LADING_STYRING_AVREISE=07:00           # bilen skal være ferdig ladet til dette klokkeslettet
# LADING_STYRING_VINDU_FRA=12            # ladingen planlegges fra dette klokkeslettet dagen før avreise
# LADING_STYRING_LADETIME_MIN_KWH=1.0    # en time teller som ladet når laderen har levert minst dette
# LADING_STYRING_MAKS_BLOKKER=2          # flere separate ladeblokker enn dette gir én sammenhengende plan
# LADING_STYRING_MARGIN_KWH=0.3          # hold timeforbruket så mye under grensen for kapasitetstrinnet
# LADING_STYRING_TAK_TIDLIG_DAGER=10     # de første dagene i måneden brukes forrige måneds trinn som gulv
# LADING_STYRING_VOLT=230                # effekt per ampere: 230 enfaset, 400 trefase i 230 V IT-nett, 690 trefase i 400 V TN-nett
# LADING_STYRING_MIN_STROM=6             # laveste ladestrøm i ampere (under dette pauses ladingen)
# LADING_STYRING_MAKS_STROM=30           # høyeste ladestrøm i ampere
# LADING_STYRING_TRYGG_STROM=10          # ladestrøm når data fra Pulse mangler
# LADING_STYRING_STROM_OPP_MIN=15        # minutter mellom økninger av strømmen (Zaptecs anbefaling)
# LADING_STYRING_STROM_NED_MIN=5         # minutter mellom reduksjoner (fasevakta kan alltid senke straks)
# LADING_STYRING_PAUSE_MIN=10            # minutter mellom pause og gjenoppta
# LADING_STYRING_MAKS_STOPP=4            # pauser per tilkobling (Zaptec Go tillater 5)
# LADING_STYRING_LAD_NAA_TIMER=12        # «Lad nå» varer så mange timer, eller til bilen kobles fra


# ─── 4. Huset og strømmen ────────────────────────────────────────────────────────────────────────────────

# LADING_SIKRING_HOVEDSIKRING_A=50       # hovedsikringen i ampere (vises på statussiden)
# LADING_SIKRING_VARSEL_A=45             # fasestrøm der fasevakta senker ladestrømmen

# LADING_PRISER_OMRAADE=NO1              # prisområde: NO1 Øst, NO2 Sør, NO3 Midt, NO4 Nord, NO5 Vest
# LADING_PRISER_HISTORIKK_FRA=2025-08-01 # spotpriser hentes bakover hit (for strømregningen tilbake i tid)

# LADING_TARIFF_DAG_FRA=6                # nettleiens dagtariff gjelder hverdager fra kl. …
# LADING_TARIFF_DAG_TIL=22               # … til kl. (natt, helg og helligdager er lavtariff)

# LADING_REGNING_MVA=0.25                # 0 der strøm er fritatt for mva (Nord-Norge)
# LADING_REGNING_STOTTE_MAKS_KWH=5000    # støtte gis for høyst så mange kWh per måned


# ─── 5. Tjenesten ────────────────────────────────────────────────────────────────────────────────────────

# LADING_WEB_HOST=127.0.0.1              # IKKE sett 0.0.0.0: websiden har ingen innlogging (se README)
# LADING_WEB_PORT=8093
# LADING_WEB_VERTER=                     # ekstra vertsnavn som godtas, kommaseparert, f.eks. tunneladressen
#                                        # lading.ditt-domene.no (127.0.0.1, localhost og ::1 godtas alltid)
# LADING_DB_STI=data/lading.db           # SQLite-databasen (relativ sti regnes fra prosjektmappa)
# LADING_ZAPTEC_POLL_SEKUNDER=60         # hvor ofte laderens status hentes
